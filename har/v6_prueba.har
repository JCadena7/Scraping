30px;\r\n            height: 50px;\r\n        }\r\n        .card-res h1 {\r\n            margin: 0;\r\n            font-size: 18px;\r\n            color:#ffffff;\r\n        }\r\n        .card-res p {\r\n            margin: 0;\r\n            font-size: 14px;\r\n        }\r\n        .card-res button {\r\n            background-color: white;\r\n            color: #003399;\r\n            border: none;\r\n            padding: 10px 20px;\r\n            border-radius: 5px;\r\n            cursor: pointer;\r\n        }\r\n        .card-res button:hover {\r\n            background-color: #f0f0f0;\r\n        }\r\n        .boton-resultados{\r\n            background-color: #ffffff;\r\n            color: #003399;\r\n            border-radius: 20px;\r\n            width: 150px;\r\n            text-align: center;\r\n        }\r\n        @media (max-width: 768px) {\r\n            .card-res {\r\n                flex-direction: column;\r\n                text-align: center;\r\n            }\r\n            .card-res img {\r\n                margin-bottom: 10px;\r\n            }\r\n        }\r\n    </style>\r\n\r\n    <div class=\"container-resultados\">\r\n        <!-- Repeat this card-res block for all 6 divs -->\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-chancemillonario.png\" alt=\"Logo\">\r\n            <h1>$1.509 MILLONES</h1>\r\n            <p>2026-10-27</p>\r\n            <a href=\"https://jer.com.co/resultados/#sorteos\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-supermillonario3_boyaca_blanco.png\" alt=\"Logo\">\r\n            <h1>$18.310.568</h1>\r\n            <p>2026-10-27</p>\r\n            <a href=\"https://jer.com.co/resultados/#sorteos\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-supermillonario3_amazonas_blanco.png\" alt=\"Logo\">\r\n            <h1>$19.291.394</h1>\r\n            <p>2026-10-27</p>\r\n            <a href=\"https://jer.com.co/resultados/#sorteos\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2025/09/logo-billonario_blanco.png\" alt=\"Logo\">\r\n            <h1>$1.115 MILLONES</h1>\r\n            <p>2026-10-27</p>\r\n            <a href=\"https://jer.com.co/resultados/#sorteos\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-baloto.png\" alt=\"Logo\">\r\n            <h1>$17.600 MILLONES</h1>\r\n            <p>2026-10-28</p>\r\n            <a href=\"https://baloto.com/resultados\" target=\"_blank\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-revancha.png\" alt=\"Logo\">\r\n            <h1>$ 4.200 MILLONES</h1>\r\n            <p>2026-10-28</p>\r\n            <a href=\"https://baloto.com/resultados\" target=\"_blank\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-miloto.png\" alt=\"Logo\">\r\n            <h1>$ 260 MILLONES</h1>\r\n            <p>2026-10-27</p>\r\n            <a href=\"https://baloto.com/miloto/resultados\" target=\"_blank\" class=\"boton-resultados\">RESULTADOS</a>\r\n        </div>\r\n        <div class=\"card-res\">\r\n            <img src=\"https://jer.com.co/wp-content/uploads/2024/12/logo-colorloto.png\" alt=\"Logo\">\r\n            <h1>$2.260 MILLONES</h1>\r\n            <p>2026-10-29</p>\r\n            <a href=\"https://baloto.com/colorloto/resultados\" target=\"_blank\" class=\"bot